#!/usr/bin/env zsh

steps=(
    "brew update"       "brew update"
    "brew upgrade"      "brew upgrade --greedy"
    "brew cleanup"      "brew cleanup --prune=0 -s"
    "omz update"        '"$ZSH/tools/upgrade.sh"'
    "macOS updates"     "softwareupdate -l"
)

assume_yes=false

case "$1" in
    -y|--yes) assume_yes=true ;;
    "") ;;
    *)
        print "Usage: update [-y|--yes]"
        exit 1
        ;;
esac

labels=()
results=()
failed=false

for label command in "${steps[@]}"; do
    print -P "\n%B%F{cyan}==> $label%f%b"

    if ! $assume_yes; then
        print -nP "Run '%F{cyan}$command%f'? %F{yellow}[Y/n]%f "
        read -r answer
        if [[ -n "$answer" && "$answer" != [Yy] ]]; then
            labels+=("$label")
            results+=(skipped)
            continue
        fi
    fi

    labels+=("$label")
    if eval "$command"; then
        results+=(ok)
    else
        results+=(failed)
        failed=true
    fi
done

print -P "\n%B==> Summary%b"
for i in {1..${#labels}}; do
    case "${results[$i]}" in
        ok)      print -P "  %F{green}✔%f ${labels[$i]}" ;;
        failed)  print -P "  %F{red}✘%f ${labels[$i]}" ;;
        skipped) print -P "  %F{yellow}–%f ${labels[$i]}" ;;
    esac
done

$failed && exit 1
exit 0
