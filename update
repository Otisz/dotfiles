#!/usr/bin/env zsh

emulate zsh

brew_update()   { brew update }
brew_cleanup()  { brew cleanup --prune=0 -s }
macos_updates() { softwareupdate -l }

fix_spotify() {
    brew uninstall spotify && brew install --cask spotify
}

brew_upgrade() {
    local spotify_outdated=0
    brew outdated --cask --greedy --quiet | grep -qx spotify && spotify_outdated=1

    brew upgrade --greedy
    local upgrade_status=$?

    if (( spotify_outdated )); then
        fix_spotify || return
    fi
    return $upgrade_status
}

omz_update() {
    if [[ -z "$ZSH" ]]; then
        print -u2 "ZSH is not set, cannot find Oh My Zsh"
        return 1
    fi
    "$ZSH/tools/upgrade.sh"
}

steps=(
    "brew update"                brew_update
    "brew upgrade --greedy"      brew_upgrade
    "brew cleanup --prune=0 -s"  brew_cleanup
    "omz update"                 omz_update
    "softwareupdate -l"          macos_updates
)

autoload -U colors && colors

heading="$bold_color$fg[cyan]"
cyan=$fg[cyan]
yellow=$fg[yellow]
green=$fg[green]
red=$fg[red]
bold=$bold_color
reset=$reset_color

assume_yes=0

case "$1" in
    -y|--yes) assume_yes=1 ;;
    "") ;;
    *)
        print -u2 "Usage: update [-y|--yes]"
        exit 1
        ;;
esac

labels=()
results=()
failed=0

for label step in "${steps[@]}"; do
    labels+=("$label")
    print -r -- $'\n'"$heading==> $label$reset"

    if (( ! assume_yes )); then
        print -rn -- "Run '$cyan$label$reset'? ${yellow}[Y/n]$reset "
        read -r answer
        case "${answer:l}" in
            ""|y|yes) ;;
            *)
                results+=(skipped)
                continue
                ;;
        esac
    fi

    if $step; then
        results+=(ok)
    else
        results+=(failed)
        failed=1
    fi
done

print -r -- $'\n'"$bold==> Summary$reset"
for i in {1..${#labels}}; do
    case "${results[$i]}" in
        ok)      print -r -- "  $green✔$reset ${labels[$i]}" ;;
        failed)  print -r -- "  $red✘$reset ${labels[$i]}" ;;
        skipped) print -r -- "  $yellow–$reset ${labels[$i]}" ;;
    esac
done

exit $failed
