#!/usr/bin/env zsh

emulate zsh
autoload -U colors && colors

###############
##   STEPS   ##
###############

spotify_outdated=0

brew_update() {
    brew update || return
    brew outdated --cask --greedy --quiet | grep -qx spotify && spotify_outdated=1
    return 0
}

brew_upgrade() { brew upgrade --greedy }

fix_spotify() {
    brew uninstall spotify && brew install --cask spotify
}

fix_spotify_needed() { (( spotify_outdated )) }

brew_cleanup() { brew cleanup --prune=0 -s }

omz_update() {
    if [[ -z "$ZSH" ]]; then
        print -u2 "ZSH is not set, cannot find Oh My Zsh"
        return 1
    fi
    "$ZSH/tools/upgrade.sh"
}

macos_updates() { softwareupdate -l }

steps=(
    "brew update"                brew_update
    "brew upgrade --greedy"      brew_upgrade
    "fix spotify"                fix_spotify
    "brew cleanup --prune=0 -s"  brew_cleanup
    "omz update"                 omz_update
    "softwareupdate -l"          macos_updates
)

###############
##  HELPERS  ##
###############

usage() {
    print -u2 "Usage: update [-y|--yes]"
}

heading() {
    print -r -- $'\n'"$bold_color${fg[cyan]}==> $1$reset_color"
}

confirm() {
    local answer
    print -rn -- "Run '${fg[cyan]}$1$reset_color'? ${fg[yellow]}[Y/n]$reset_color "
    read -r answer
    [[ "${answer:l}" == (|y|yes) ]]
}

print_summary() {
    local label result
    print -r -- $'\n'"$bold_color==> Summary$reset_color"
    for label result in "$@"; do
        case "$result" in
            ok)      print -r -- "  ${fg[green]}✔$reset_color $label" ;;
            failed)  print -r -- "  ${fg[red]}✘$reset_color $label" ;;
            skipped) print -r -- "  ${fg[yellow]}–$reset_color $label" ;;
        esac
    done
}

##############
##   MAIN   ##
##############

main() {
    local assume_yes=0 failed=0 label step
    local -a summary

    case "$1" in
        -y|--yes) assume_yes=1 ;;
        "") ;;
        *)
            usage
            return 1
            ;;
    esac

    for label step in "${steps[@]}"; do
        if (( $+functions[${step}_needed] )) && ! ${step}_needed; then
            summary+=("$label" skipped)
            continue
        fi

        heading "$label"

        if (( ! assume_yes )) && ! confirm "$label"; then
            summary+=("$label" skipped)
            continue
        fi

        if $step; then
            summary+=("$label" ok)
        else
            summary+=("$label" failed)
            failed=1
        fi
    done

    print_summary "${summary[@]}"
    return $failed
}

main "$@"
